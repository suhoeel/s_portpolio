NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Server-only (never expose to the browser). Used for writing posts and uploading images.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Optional: when set, writing/uploading requires this token (the editor asks for it once).
ADMIN_TOKEN=

# Optional: when set, the AI bot writes an answer from the retrieved posts. Without it, it shows search results only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
